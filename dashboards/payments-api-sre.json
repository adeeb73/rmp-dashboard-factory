{
  "apiVersion": "rmp/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "payments-api-sre",
    "title": "Payments API SRE Dashboard",
    "description": "Production monitoring dashboard for the payments API, tracking key SRE metrics including rate, errors, latency, and saturation.",
    "owner": "payments-team",
    "tags": [
      "env:production",
      "team:payments",
      "owner:payments-team"
    ]
  },
  "spec": {
    "refreshIntervalSeconds": 60,
    "timeRange": "6h",
    "panels": [
      {
        "id": "request_rate",
        "title": "Request Rate",
        "type": "timeseries",
        "metric": "rmp.payments.requests.rate",
        "unit": "count"
      },
      {
        "id": "p99_latency",
        "title": "P99 Latency",
        "type": "timeseries",
        "metric": "rmp.payments.latency.p99",
        "unit": "ms",
        "thresholds": [
          {
            "value": 200,
            "severity": "info"
          },
          {
            "value": 500,
            "severity": "warning"
          },
          {
            "value": 1000,
            "severity": "critical"
          }
        ]
      },
      {
        "id": "error_rate",
        "title": "Error Rate",
        "type": "stat",
        "metric": "rmp.payments.errors.ratio",
        "unit": "ratio",
        "thresholds": [
          {
            "value": 0.01,
            "severity": "warning"
          },
          {
            "value": 0.05,
            "severity": "critical"
          }
        ]
      },
      {
        "id": "conn_pool_saturation",
        "title": "Connection Pool Saturation",
        "type": "gauge",
        "metric": "rmp.payments.connection_pool.saturation",
        "unit": "percent",
        "thresholds": [
          {
            "value": 75,
            "severity": "warning"
          },
          {
            "value": 90,
            "severity": "critical"
          }
        ]
      }
    ]
  }
}
